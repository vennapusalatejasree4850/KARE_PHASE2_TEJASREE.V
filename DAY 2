import java.util.Scanner;

public class EvenNumbers
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter N: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++)
        {
            if (i % 2 != 0)
            {
                continue;
            }

            System.out.print(i + " ");
        }

        sc.close();
    }
}
