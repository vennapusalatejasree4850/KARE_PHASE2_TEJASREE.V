// SINGLE NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int m = 0;
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
            m = m ^ arr[i];
        }
        System.out.print("Single Number: " + m);
    }
}

