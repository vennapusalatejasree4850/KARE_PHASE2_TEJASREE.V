// MISSING NUMBER
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int sum = 0;
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            sum += arr[i];
        }
        int sumn = (n + 1) * (n + 2) / 2;
        System.out.println("Missing Number: " + (sumn - sum));
    }
}

