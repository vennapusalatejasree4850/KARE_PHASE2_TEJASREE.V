// Arranging 0 and 1 in line
// i/p                    o/p
//  5
// 0 1 0 1 0            0 0 0 1 1
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i,zc=0;
        for(i=0;i<n;i++){
            arr[i] = sc.nextInt();
            if(arr[i]==0)
            zc++;
        }
        for(i = 0; i < zc; i++)
        arr[i] = 0;
        for(i = zc; i < n; i++)
        arr[i] = 1;
        for(i = 0; i < n; i++)
        System.out.print(arr[i] + " ");
    }
}

