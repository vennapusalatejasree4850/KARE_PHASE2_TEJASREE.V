// To count positive, negative and zero elements
// i/p                      o/p
//  7
// 10 -5 0 20 -8 0 15
// Positive: 3
// Negative: 2
// Zero: 2
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i, pc = 0, nc = 0, zc = 0;
        for(i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            if(arr[i] > 0)
                pc++;
            else if(arr[i] < 0)
                nc++;
            else
                zc++;
        }
        System.out.println("Positive: " + pc);
        System.out.println("Negative: " + nc);
        System.out.println("Zero: " + zc);
    }
}
