// Arranging 0,1,2 in line
// i/p                      o/p
//  6
// 0 1 2 0 1 0            0 0 0 1 1 2 
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i,zc=0,oc=0;
        for(i=0;i<n;i++){
            arr[i] = sc.nextInt();
            if(arr[i]==0)
            zc++;
            else if(arr[i]==1)
            oc++;
        }
        for(i = 0; i < zc; i++)
        arr[i] = 0;
        for(i = zc; i < zc+oc; i++)
        arr[i] = 1;
        for(i = zc+oc; i < n; i++)
        arr[i] = 2;
        for(i = 0; i < n; i++)
        System.out.print(arr[i] + " ");
    }
}

