// To find the second minimum value
// i/p                      o/p
//  5
// 10 20 5 25 15             10
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i, min, smin;
        for(i = 0; i < n; i++)
            arr[i] = sc.nextInt();
        if(arr[0] < arr[1]) {
            min = arr[0];
            smin = arr[1];
        }
        else {
            min = arr[1];
            smin = arr[0];
        }
        for(i = 2; i < n; i++) {
            if(arr[i] < min) {
                smin = min;
                min = arr[i];
            }
            else if(arr[i] < smin && arr[i] > min) {
                smin = arr[i];
            }
        }
        System.out.print("SECOND MINIMUM ELEMENT: " + smin);
    }
}

