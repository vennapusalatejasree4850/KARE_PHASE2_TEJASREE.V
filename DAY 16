// SORT THE DOUBLY LINKED LIST
import java.util.*;
class Node {
    int data;
    Node next, prev;
    Node(int d) {
        this.data = d;
        this.next = null;
        this.prev = null;
    }
}
class Main {
    Node first;
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Main m = new Main();
        int d = sc.nextInt();
        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }
        m.sort();
        m.display();
    }
    void insert(int d) {
        Node n = new Node(d);
        if (first == null) {
            first = n;
            return;
        }
        Node temp = first;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = n;
        n.prev = temp;
    }
    void sort() {
        if (first == null) {
            return;
        }
        Node i = first;
        while (i != null) {
            Node j = i.next;
            while (j != null) {
                if (i.data > j.data) {
                    int temp = i.data;
                    i.data = j.data;
                    j.data = temp;
                }
                j = j.next;
            }
            i = i.next;
        }
    }
    void display() {
        Node temp = first;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }
}

// INSERT ELEMENT IN A DOUBLY LINKED LIST
import java.util.*;
class Node {
    int data;
    Node next, prev;
    Node(int d) {
        this.data = d;
        this.next = null;
        this.prev = null;
    }
}
class Main {
    Node first;
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Main m = new Main();
        int d = sc.nextInt();
        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }
        int element = sc.nextInt();
        int position = sc.nextInt();
        m.insertAtPosition(element, position);
        m.display();
    }
    void insert(int d) {
        Node n = new Node(d);
        if (first == null) {
            first = n;
            return;
        }
        Node temp = first;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = n;
        n.prev = temp;
    }
    void insertAtPosition(int element, int position) {
        Node n = new Node(element);
        if (position == 1) {
            n.next = first;
            if (first != null) {
                first.prev = n;
            }
            first = n;
            return;
        }
        Node temp = first;
        for (int i = 1; i < position - 1 && temp != null; i++) {
            temp = temp.next;
        }
        if (temp == null) {
            System.out.println("Invalid position");
            return;
        }
        n.next = temp.next;
        n.prev = temp;
        if (temp.next != null) {
            temp.next.prev = n;
        }
        temp.next = n;
    }
    void display() {
        Node temp = first;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }
}
