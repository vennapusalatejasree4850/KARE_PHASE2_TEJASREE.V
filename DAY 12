// FIND THE POWER OF THE GIVEN NUMBER WITHOUT USING IN-BUILT METHOD AND BY USING FUNCTION WITH ARGUMENT,WITH RETURNTYPE
import java.util.*;
class Main {
    int powerofn(int b, int p){
        int r=1;
        while(p!=0){
            r=r*b;
            p--;
        }
        return r;
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int b = sc.nextInt();
        int p = sc.nextInt();
        Main m = new Main();
        int ans = m.powerofn(b,p);
        System.out.print(ans);
    }
}

