// WRITE A JAVA PROGRAM TO CHECK THE SPECIFIC NUMBER IS SQUARE OR NOT BY USING FUNCTION WITH NO ARGUMENT NO RETURNTYPE
import java.util.*;
class Main{
    void ps(){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int flag = 0,i;
        for(i=1;i<=n/2;i++){
            if(i*i == n){
                flag=1;
                System.out.print("Perfect Square");
                break;
            }
        }
        if(flag == 0)
        System.out.print("Not a perfect square");
    }
    public static void main(String[] args){
        Main m = new Main();
        m.ps();
    }
}

