// WRITE A JAVA PROGRAM TO AUTO MORPHIC NUMBER BY USING FUNCTION WITH NO ARGUMENT WITH RETURNTYPE
import java.util.*;
class Main{
    boolean am(){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp=n,c=0;
        int sqr = n*n;
        while(n!=0){
            n=n/10;
            c++;
        }
        int power=(int)Math.pow(10,c);
        if(sqr%power==temp)
        return true;
        else
        return false;
    }
    public static void main(String[] args){
        Main m = new Main();
        boolean ans = m.am();
        if(ans){
        System.out.print("Automorphic Number");
        }else{
        System.out.print("Not an Automorphic Number");
        }
    }
}

