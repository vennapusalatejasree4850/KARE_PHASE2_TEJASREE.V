// WRITE A JAVA PROGRAM TO CHECK THE GIVEN NUMBER IS POWER OF 2 OR NOT BY USING FUNCTION WITH ARGUMENT NO RETURNTYPE
import java.util.*;
class Main{
    void powerof2(int a){
        while(a%2==0){
            a=a/2;
        }
        if(a==1)
        System.out.print("Power of 2");
        else
        System.out.print("Not a power of 2");
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Main m = new Main();
        m.powerof2(n);
    }
}

