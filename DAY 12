// WRITE A JAVA PROGRAM TO CHECK PERFECT CUBE OR NOT BY USING FUNCTION WITH ARGUMENT WITH RETURNTYPE
import java.util.*;
class Main {
    boolean pc(int x) {
        for (int i = 1; i <= x/2; i++) {
            if (i * i * i == x) {
                return true;
            }
        }
        return false;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Main m = new Main();
        boolean ans = m.pc(n);
        if (ans)
            System.out.print("Perfect Cube");
        else
            System.out.print("Not a perfect cube");
    }
}

