// INHERITANCE WITH VARIABLES
class Father {
    int money = 10000;
    void displayFather() {
        System.out.println("Father Money: " + money);
    }
}
class Son extends Father {
    int diamond = 5000;
    void displaySon() {
        System.out.println("Son Diamond: " + diamond);
    }
}
class Main {
    public static void main(String[] args) {
        Son s = new Son();
        s.displayFather();
        s.displaySon();
        System.out.println("Father Money: " + s.money);
        System.out.println("Son Diamond: " + s.diamond);
    }
}

