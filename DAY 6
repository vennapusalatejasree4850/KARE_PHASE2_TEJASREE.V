// Write a java program t0 count the odd,even digits in the given number
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ec=0,oc=0,d;
        while(n!=0){
            d=n%10;
            if(d%2==0)
            ec++;
            else
            oc++;
            n=n/10;
        }
        System.out.print("Odd digit count: " + oc);
        System.out.print("Even digit count: " + ec);
    }
}

