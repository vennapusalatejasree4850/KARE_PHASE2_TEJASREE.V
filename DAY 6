// PERFECT NUMBER
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum=0,i;
        for(i=1;i<=n/2;i++){
            if(n%i==0)
            sum=sum+i;
        }
        if (sum == n)
            System.out.print("PERFECT NUMBER");
        else
            System.out.print("NOT A PERFECT NUMBER");
    }
}

