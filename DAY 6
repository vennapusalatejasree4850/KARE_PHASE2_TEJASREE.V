// NEON NUMBER
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int square = n * n;
        int sum = 0, d;
        while (square != 0) {
            d = square % 10;
            sum = sum + d;
            square = square / 10;
        }
        if (sum == n)
            System.out.print("NEON NUMBER");
        else
            System.out.print("NOT A NEON NUMBER");
    }
}

