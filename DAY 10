// UNIQUE ELEMENT COUNT
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        int arr[] = new int[256];
        int c= 0;
        for(char ch:s.toCharArray()){
            arr[ch]++;
        }
        for(int i = 0; i< 256;i++){
            if(arr[i]==1)
            c++;
        }
        System.out.print("Unique element count: " + c);
    }    
}

