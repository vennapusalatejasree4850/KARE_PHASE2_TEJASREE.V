// FIND SUM OF N NATURAL NUMBERS USING RECURSION
import java.util.*;
public class Main {
    static int sum(int n) {
        if(n == 0)
            return 0;
        return n + sum(n - 1);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ans = sum(n);
        System.out.println(ans);
    }
}

