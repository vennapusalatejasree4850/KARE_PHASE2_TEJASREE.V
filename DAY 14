// CONSTRUCTOR OVERLOADING
public class Main {
    int a;
    int b;
    Main() {
        a = 10;
        b = 20;
    }
    Main(int x) {
        a = x;
        b = 30;
    }
    Main(int x, int y) {
        a = x;
        b = y;
    }
    void display() {
        System.out.println(a + " " + b);
    }
    public static void main(String[] args) {
        Main obj1 = new Main();
        obj1.display();
        Main obj2 = new Main(50);
        obj2.display();
        Main obj3 = new Main(60, 70);
        obj3.display();
    }
}

