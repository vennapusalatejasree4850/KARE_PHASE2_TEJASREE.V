import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int row,col,n;
        n = sc.nextInt();
        n = 2*n-1;
        for(row=0;row<n;row++,System.out.println()){
            for(col=0;col<n;col++){
                if(row==0||row==n-1||col==0||col==n-1||row==col||row+col==n-1)
                    System.out.print("*");
                else
                    System.out.print(" ");
            }
        }
    }
}

